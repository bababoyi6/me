     #[tokio::test]
+    async fn live_stale_profile_uses_default_and_is_marked_for_retry() {
+        let domains = vec!["stale.example".to_string(), "fresh.example".to_string()];
+        let cache = TlsFrontCache::new(&domains, 1024, "tlsfront-test-cache");
+        let mut stale = cached_with_cert_info("stale.example", None, Vec::new());
+        stale.fetched_at = SystemTime::now() - Duration::from_secs(73 * 3600);
+        cache.set("stale.example", stale).await;
+        let mut fresh = cached_with_cert_info("fresh.example", None, Vec::new());
+        fresh.fetched_at = SystemTime::now() - Duration::from_secs(71 * 3600);
+        cache.set("fresh.example", fresh).await;
+
+        assert_eq!(cache.get("stale.example").await.domain, "default");
+        assert_eq!(cache.get("fresh.example").await.domain, "fresh.example");
+        assert_eq!(cache.default_profile_domains(&domains).await, vec!["stale.example".to_string()]);
+        let (health, suppressed) = cache.profile_health_snapshot(&domains, 2).await;
+        assert_eq!(suppressed, 0);
+        assert!(health[0].is_default);
+        assert_eq!(health[0].source, "default");
+        assert!(!health[1].is_default);
+
+        cache
+            .set("stale.example", cached_with_cert_info("stale.example", None, Vec::new()))
+            .await;
+        assert_eq!(cache.get("stale.example").await.domain, "stale.example");
+        assert!(cache.default_profile_domains(&domains).await.is_empty());
+    }
