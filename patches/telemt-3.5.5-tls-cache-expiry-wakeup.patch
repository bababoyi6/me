+    /// Wake the refresh task when an in-memory fetched profile first becomes stale.
+    pub(crate) async fn next_profile_expiry_delay(&self, domains: &[String]) -> Option<Duration> {
+        let guard = self.memory.read().await;
+        let now = SystemTime::now();
+        domains
+            .iter()
+            .filter_map(|domain| guard.get(domain).and_then(|entry| profile_expiry_delay(entry, now)))
+            .min()
     }
 
