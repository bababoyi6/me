+
+fn profile_expiry_delay(cached: &CachedTlsData, now: SystemTime) -> Option<Duration> {
+    if cached.domain == "default" {
+        return None;
+    }
+    let age = now.duration_since(cached.fetched_at).ok()?;
+    (age <= TLS_PROFILE_MAX_AGE)
+        .then(|| TLS_PROFILE_MAX_AGE - age + Duration::from_millis(1))
 }
 
