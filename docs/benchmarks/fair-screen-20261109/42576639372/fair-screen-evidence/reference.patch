+#[cfg(target_os = "linux")]
+#[tokio::test]
+async fn tdh_client_send_stays_automatic() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let (client, accepted) = tokio::join!(tokio::net::TcpStream::connect(listener.local_addr().unwrap()), listener.accept());
+    let _client = client.unwrap();
+    let (server, _) = accepted.unwrap();
+    let socket = socket2::SockRef::from(&server);
+    let previous = socket.send_buffer_size().unwrap();
+    super::configure_client_socket(&server, 30, 30).unwrap();
+    assert_eq!(socket.send_buffer_size().unwrap(), previous);
+    assert!(socket.tcp_nodelay().unwrap());
+}
diff --git a/src/transport/socket/low_rtt_receive.rs b/src/transport/socket/low_rtt_receive.rs
new file mode 100644
--- /dev/null
+++ b/src/transport/socket/low_rtt_receive.rs
@@ -0,0 +1,29 @@
+use std::io;
+use std::os::fd::RawFd;
+
+// Keep automatic receive sizing on unknown/long-RTT entry links. On a short
+// entry-to-backend hop, a 256KiB request avoids multi-MiB receive bursts without
+// changing the client send buffer or the high-RTT DC receive path.
+pub(super) fn receive_request(rtt_us: u32) -> Option<libc::c_int> {
+    (rtt_us > 0 && rtt_us <= 5_000).then_some(256 * 1024)
+}
+
+pub(super) fn configure_low_rtt_receive(fd: RawFd) -> io::Result<Option<u32>> {
+    let mut info: libc::tcp_info = unsafe { std::mem::zeroed() };
+    let mut size = std::mem::size_of_val(&info) as libc::socklen_t;
+    let result = unsafe {
+        libc::getsockopt(fd, libc::IPPROTO_TCP, libc::TCP_INFO,
+                        (&mut info as *mut libc::tcp_info).cast(), &mut size)
+    };
+    let required = std::mem::offset_of!(libc::tcp_info, tcpi_rtt) + std::mem::size_of::<u32>();
+    if result != 0 || (size as usize) < required {
+        return Ok(None);
+    }
+    let Some(request) = receive_request(info.tcpi_rtt) else { return Ok(None) };
+    let result = unsafe {
+        libc::setsockopt(fd, libc::SOL_SOCKET, libc::SO_RCVBUF,
+                        (&request as *const libc::c_int).cast(),
+                        std::mem::size_of_val(&request) as libc::socklen_t)
+    };
+    if result == 0 { Ok(Some(info.tcpi_rtt)) } else { Err(io::Error::last_os_error()) }
+}
diff --git a/src/transport/socket/unsent_queue_bulk.rs b/src/transport/socket/unsent_queue_bulk.rs
new file mode 100644
--- /dev/null
+++ b/src/transport/socket/unsent_queue_bulk.rs
@@ -0,0 +1,19 @@
+use std::io;
+use std::os::fd::RawFd;
+
+// Keep automatic buffers and bound unsent data at the former 256KiB write
+// request scale. A larger batch may reduce readiness wakeups; throughput and
+// latency still require paired measurement, and in-flight bytes are not capped.
+pub(super) fn configure_unsent_queue(fd: RawFd) -> io::Result<()> {
+    let limit: libc::c_uint = 256 * 1024;
+    let result = unsafe {
+        libc::setsockopt(
+            fd,
+            libc::IPPROTO_TCP,
+            libc::TCP_NOTSENT_LOWAT,
+            (&limit as *const libc::c_uint).cast(),
+            std::mem::size_of_val(&limit) as libc::socklen_t,
+        )
+    };
+    if result == 0 { Ok(()) } else { Err(io::Error::last_os_error()) }
+}
